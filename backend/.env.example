# ─────────────────────────────────────────────────────────────────────────────
# .env.example — plantilla de configuración por entorno.
#   cp .env.example .env   y rellena los secretos. NUNCA comitees `.env`.
# La carga la hace pydantic-settings (BaseSettings) en app/core (tarea 07):
# sin efectos en import, todo inyectable. docker-compose lee este mismo set.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production | test

# ── Base de datos (Postgres + pgvector) ──────────────────────────────────────
# URL async (driver asyncpg) del rol RUNTIME `syntax_app` — NO superuser, para que las
# políticas RLS de aislamiento tenant apliquen de verdad. En compose el host es el
# servicio `db`. El rol `syntax_app` lo crea un init script (tarea 06) y su password se
# fija out-of-band (ALTER ROLE desde SYNTAX_APP_PASSWORD).
DATABASE_URL=postgresql+asyncpg://syntax_app:syntax_app@localhost:5432/syntax
# Password del rol runtime `syntax_app` (la aplica el init script):
SYNTAX_APP_PASSWORD=syntax_app
# URL de MIGRACIONES (rol SUPERUSER). La lee alembic/env.py del entorno; NO es campo de
# Settings (least-privilege: la API nunca arranca con credenciales superuser).
# Descoméntala para correr migraciones/bootstrap del rol:
# MIGRATION_DATABASE_URL=postgresql+asyncpg://syntax:syntax@localhost:5432/syntax
# Credenciales del SUPERUSER que consume docker-compose para levantar `db`:
POSTGRES_USER=syntax
POSTGRES_PASSWORD=syntax
POSTGRES_DB=syntax
POSTGRES_PORT=5432
API_PORT=8000

# ── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-prod        # secreto de firma (genera uno fuerte por entorno)
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL=900                   # access token (segundos) — en memoria en el cliente
JWT_REFRESH_TTL=1209600             # refresh token (segundos, 14d) — cookie httpOnly, rotación

# ── LLM / embeddings (OpenAI por defecto; puerto conmutable) ─────────────────
LLM_PROVIDER=openai                  # selector del adaptador de puerto LLM (openai | ...)
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini              # modelo de chat/clasificación (structured output)
# LLM_TEMPERATURE=0.0                # [0.0, 2.0]; 0.0 = máximo determinismo (classify/grade/generate)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                   # dimensión del vector — FUENTE de la columna vector(N); re-embed si cambia

# ── Ingestión de la KB (`make ingest`) ───────────────────────────────────────
# KB_SOURCE_PATH=/ruta/a/la/kb      # raíz del árbol de Markdown; si falta, se pasa como argumento
# KB_SOURCE_TYPE=packages-uc        # packages-uc (real verificado, default) | vitepress-domains (hipotético)
#                                   # ⚠️ cambiarlo sobre una BD con corpus RECONCILIA (borra) el formato anterior
# KB_PACKAGE_ALIASES={"vendor-render": "syntax-render"}
#                                   # JSON cadena→cadena: subdirectorio de package → valor del enum Package.
#                                   # Solo lo usa packages-uc; vacío ⇒ no se ingiere ningún UC (avisa por stderr)

# ── Retrieval de la KB (`GET /kb/search`) ────────────────────────────────────
# RAG_ESTADO_WEIGHT=0.05            # boost de `active` en el re-ranking: score * (1 + w); draft NO se toca.
#                                   # 0 = desempate desactivado (orden por similitud pura). Negativo: rechazado.
# RAG_SEARCH_WINDOW=100             # ventana de recuperación, en DOCUMENTOS (= page_size máximo del contrato)
# RAG_CHUNKS_PER_DOC=6              # over-fetch de chunks sobre la ventana (~5.7 chunks/doc medidos)

# ── Grafo del agente (HITL) ───────────────────────────────────────────────────
# AGENT_CONFIDENCE_THRESHOLD=0.6    # bajo este umbral, `decide` escala a HITL en vez de auto-responder
#                                   # [0.0, 1.0]; default de arranque sin calibrar (sin corpus de runs reales)

# ── LangSmith (tracing/observabilidad) ───────────────────────────────────────
# Versión mínima y explícitamente parcial (agent-graph.md §9, tarea backend-agent-graph-11): solo
# puebla agent_run.langsmith_trace_url. Sin dashboards/alerting — follow-up pendiente.
LANGSMITH_TRACING=false             # true para enviar trazas (además hace falta LANGSMITH_API_KEY)
LANGSMITH_API_KEY=                  # vacío desactiva el tracing aunque LANGSMITH_TRACING=true
LANGSMITH_PROJECT=syntax

# ── Límites / throttling (B.1 promovido a Fase 1; los consumen 07/11/12) ──────
# LOGIN_MAX_ATTEMPTS=5              # intentos antes de throttling de login
# LOGIN_WINDOW_SECONDS=300         # ventana del throttling
# AI_DRAFT_MAX_PER_TICKET=10       # tope de generaciones de draft IA por ticket
