# Copia a `.env.local` y ajusta. El SPA (client-rendered) llama directamente a la API
# del backend (contrato OpenAPI 3.1). No hay BFF de Next.

# Base URL de la API del backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Habilita el mock service worker (MSW) en el navegador durante desarrollo.
# En tests, MSW se arranca siempre desde el server de Node (no usa esta variable).
NEXT_PUBLIC_ENABLE_MSW=true
